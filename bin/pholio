#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Pholio command-line entry point. See `pholio --help` and src/Cli.php.
 */

if (PHP_VERSION_ID < 80200) {
    fwrite(STDERR, 'pholio: PHP 8.2 or newer is required, this is ' . PHP_VERSION . "\n");
    exit(2);
}

require __DIR__ . '/../src/Cli.php';

exit(Pholio\Cli::main($argv));
