Subject: [PATCH 1/2] =?UTF-8?q?test(docs):=20check=20content=20tr=C3=A9e?=

Checks redirect targets and internal links.
---
 tests/links_test.php | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/tests/links_test.php b/tests/links_test.php
index 1111111..2222222 100644
--- a/tests/links_test.php
+++ b/tests/links_test.php
@@ -1,8 +1,16 @@
 <?php
 declare(strict_types=1);
 
-function test_links(): void
+/**
+ * @covers \Acme\Docs\Links
+ */
+function test_links(array $pages = []): void
 {
-    assert(true);
+    foreach ($pages as $path => $html) {
+        preg_match_all('/href="([^"]+)"/', $html, $matches);
+        foreach ($matches[1] as $target) {
+            assert(str_starts_with($target, '/guide/'), "External link in $path: $target");
+        }
+    }
 }
 
 test_links();
-- 
