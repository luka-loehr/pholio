    {
      "name": "search-pointer-third-result",
      "_note": "Only settled: React writes the active entry in the next render, Pholio immediately. Both happen before the same paint; at frame0 only the difference between a microtask and the React render cycle would show.",
      "page": "/guide",
      "actions": [
        { "click": "button[data-search-full]" },
        { "wait": 800 },
        { "press": "Escape" },
        { "wait": 800 },
        { "click": "button[data-search-full]" },
