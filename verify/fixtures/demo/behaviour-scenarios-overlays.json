        { "press": "Escape" },
        { "wait": 800 },
        { "press": "Meta+k" },
        { "wait": 600 },
        { "press": "Meta+k", "sample": true },
        { "wait": 600 },
        { "press": "Meta+k", "sample": true }
      ],
      "observe": {
