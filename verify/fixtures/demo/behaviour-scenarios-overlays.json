{
  "_doc": "Behaviour scenarios for the overlays of the demo site (examples/demo): search dialog, section switcher, theme switch and heading anchors. Format: see the header of verify/behaviour.mjs. Paths are demo site paths. Scenarios with the search dialog start with a warm-up step (open, close): a Fumadocs reference loads the dialog through React.lazy, so the very first click lags two frames behind. Pholio loads nothing lazily; the warm-up step gives both sides the same starting state. Class lists are not compared: the reference carries Tailwind utilities, Pholio nd- classes. Observed is what the classes do (computed styles, animations, attributes, the icon name through \"icons\").",
  "scenarios": [
    {
      "name": "search-open",
      "page": "/guide",
      "actions": [
        { "click": "button[data-search-full]" },
        { "wait": 800 },
        { "press": "Escape" },
        { "wait": 800 },
        { "click": "button[data-search-full]" }
      ],
      "observe": {
        "selectors": [
          "#fd-search-dialog-content",
          "body > div[role=presentation]",
          "button[data-search-full]",
          "[data-base-ui-portal]",
          "#fd-search-dialog-content [data-empty]"
        ],
        "attributes": ["data-open", "data-closed", "data-starting-style", "data-ending-style", "aria-expanded", "aria-haspopup", "role", "tabindex", "data-empty", "style", "hidden", "aria-hidden", "data-base-ui-inert"],
        "styleProps": ["opacity", "transform", "height"],
        "animations": true,
        "focus": true,
        "scrollLocked": true
      },
      "sample": ["frame0", "frame1", "animationend", "settled"]
    },
    {
      "name": "search-escape",
      "page": "/guide",
      "actions": [
        { "click": "button[data-search-full]" },
        { "wait": 800 },
        { "press": "Escape" },
        { "wait": 800 },
        { "click": "button[data-search-full]" },
        { "wait": 600 },
        { "press": "Escape", "sample": true }
      ],
      "observe": {
        "selectors": ["#fd-search-dialog-content", "body > div[role=presentation]", "button[data-search-full]", "[data-base-ui-portal]"],
        "attributes": ["data-open", "data-closed", "data-starting-style", "data-ending-style", "aria-expanded", "hidden", "aria-hidden", "data-base-ui-inert"],
        "animations": true,
        "focus": true,
        "scrollLocked": true
      },
      "sample": ["frame0", "frame1", "animationend", "settled"]
    },
    {
      "name": "search-outside-click",
      "page": "/guide",
      "actions": [
        { "click": "button[data-search-full]" },
        { "wait": 800 },
        { "press": "Escape" },
        { "wait": 800 },
        { "click": "button[data-search-full]" },
        { "wait": 600 },
        { "click": "body > div[role=presentation]", "sample": true }
      ],
      "observe": {
        "selectors": ["#fd-search-dialog-content", "[data-base-ui-portal]", "button[data-search-full]"],
        "attributes": ["data-open", "data-closed", "data-ending-style", "aria-expanded"],
        "animations": true,
