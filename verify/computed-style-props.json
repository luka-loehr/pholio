  "states": [
    {
      "name": "sidebar-item",
      "selector": "#nd-sidebar a[href]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "First entry of the sidebar. The 4 px hover zone at the edge is never touched: it only triggers the expand logic in the collapsed state, and the comparison runs expanded."
    },
    {
      "name": "sidebar-folder-trigger",
      "selector": "#nd-sidebar button[aria-expanded]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Folder trigger (Base UI Collapsible). Hover and focus only, no click: a click would change the tree."
    },
    {
      "name": "toc-link",
      "selector": "#nd-toc a[href^=\"#\"]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "First entry of the table of contents in the main column."
    },
    {
      "name": "footer-card",
      "selector": "#nd-page > div:last-of-type > a[href]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Previous and next cards at the page footer."
    },
    {
      "name": "area-card",
      "selector": "main#nd-home-layout > main > section > div > a[href]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Section card of the start page, selected by structure because the reference carries rounded-xl and the candidate nd-home-card; other pages don't have the selector and skip the state."
    },
    {
      "name": "nav-link",
      "selector": "#nd-subnav a[href]:visible, #nd-nav ul a[href]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Navigation link in the header, selected by structure; on the start page the header has no #nd-subnav, so the links in #nd-nav's list are used."
    },
    {
      "name": "search-trigger",
      "selector": "button[data-search-full]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Full search field of the header."
    },
    {
      "name": "theme-switch",
      "selector": "button[data-theme-toggle]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Theme switch. Hover and focus only, no click: a click would switch the theme of the comparison."
    },
    {
      "name": "heading-copy",
      "selector": ":is(h1,h2,h3,h4,h5,h6)[id] > button[aria-label]:visible",
      "actions": [
        "hover",
        "focus"
      ],
      "note": "Copy button of the first heading; it only becomes visible while the heading is hovered."
    },
    {
      "name": "callout",
      "selector": "div.prose div[style*=\"--callout-color\"]:visible",
      "actions": [
        "hover"
      ],
      "note": "First callout in the running text."
    },
    {
      "name": "table-row",
      "selector": "div.prose table tbody tr:visible",
      "actions": [
        "hover"
      ],
      "note": "First row of the first table."
    },
    {
      "name": "sidebar-collapsed",
      "selector": "#nd-notebook-layout",
      "steps": [
        { "click": "button[data-collapsed]:visible" },
        { "wait": 600 },
        { "mouse": [900, 700] },
        { "wait": 300 }
      ],
      "widths": [1440, 1024],
      "note": "Sidebar collapsed through its trigger, mouse far from the hover zone; the whole layout is compared. The trigger is hidden below 768 px, hence the widths. The page is loaded again afterwards."
    },
    {
      "name": "sidebar-collapsed-hovered",
      "selector": "#nd-notebook-layout",
      "steps": [
        { "click": "button[data-collapsed]:visible" },
        { "wait": 600 },
        { "hover": "[data-sidebar-placeholder] > div:first-child" },
        { "wait": 600 }
      ],
      "widths": [1440, 1024],
      "note": "Collapsed sidebar shown again through the 4 px hover zone, the first child of [data-sidebar-placeholder] on both sides while collapsed."
    }
  ]
}
