</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)(^\.|~$|^(?:Thumbs\.db|Desktop\.ini)$|\.(?:bak|old|orig|save|swp|swo|tmp|temp|log|sql|sqlite|db|ini|env|php[0-9]?|phtml|phar|cgi|pl|py|sh|bash|zsh|exe|dll|so|dylib|jar|war|class)$)">
        Require all denied
